# Application
APP_NAME=Ticket Booking Auth Service
NODE_ENV=development
APP_PORT=3001
APP_BASE_URL=http://localhost:3001
APP_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_booking
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=auth-service

# Mail (MailHog for development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@ticketbooking.com

# OAuth2 - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth2/callback/google

# OAuth2 - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth2/callback/github

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
MAX_DEVICES_PER_USER=3
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ML service
ML_SERVICE_URL=http://localhost:8000/api/ml
ML_API_KEY=CHANGE_ME_must_match_ml_service_API_KEY

# Mux (optional livestream)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Browser-facing API base: absolute URL (CORS + cookies) or "/api" to use the Next.js rewrite proxy (same-origin)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-side backend URL for rewrites + webhook proxies (not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:3001

# Socket.IO server origin (seat locking)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# MUST match the backend JWT_SECRET — middleware verifies the access_token cookie with it
JWT_SECRET=CHANGE_ME_same_value_as_backend

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# OAuth2 backend base URL (no /api/v1 suffix)
NEXT_PUBLIC_OAUTH2_BASE_URL=http://localhost:3001

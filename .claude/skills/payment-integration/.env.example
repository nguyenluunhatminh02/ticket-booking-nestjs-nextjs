# =============================================================================
# Payment Integration Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# These variables are required for payment processing integrations.
# =============================================================================

# -----------------------------------------------------------------------------
# Polar (Payment Provider)
# -----------------------------------------------------------------------------

# Polar Webhook Secret
# Purpose: Verifies that webhooks are actually from Polar
# How to obtain:
#   1. Log in to your Polar dashboard (https://polar.sh)
#   2. Go to Settings > Webhooks
#   3. Create or edit a webhook endpoint
#   4. Copy the webhook secret
# IMPORTANT: Keep this secret! Never expose it in client-side code
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Polar Access Token
# Purpose: Authenticates API requests to Polar
# How to obtain:
#   1. Log in to your Polar dashboard (https://polar.sh)
#   2. Go to Settings > API Keys
#   3. Generate a new personal access token
#   4. Copy the token (starts with "polar_")
# IMPORTANT: Treat this like a password - never commit it to git!
POLAR_ACCESS_TOKEN=your-polar-access-token

# -----------------------------------------------------------------------------
# SePay (Vietnamese Payment Gateway)
# -----------------------------------------------------------------------------

# SePay Secret Key
# Purpose: Authenticates webhook callbacks from SePay
# How to obtain:
#   1. Log in to your SePay account (https://sepay.vn)
#   2. Go to Settings > API Integration
#   3. Copy your secret key from the API credentials section
# IMPORTANT: Keep this secret! Used to verify payment callbacks
SEPAY_SECRET_KEY=your-sepay-secret-key
